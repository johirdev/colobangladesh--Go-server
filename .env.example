# =============================================================================
# CholoBangladesh API — environment template — copy to .env and fill in
# Generate secrets: openssl rand -hex 48 (JWT), -hex 32 (OTP), -base64 32 (DATA_ENCRYPTION_KEY)
# =============================================================================

# ----------------------
# App
# ----------------------
APP_NAME=CholoBangladesh
APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Reverse proxies allowed to set X-Forwarded-For (e.g. nginx/Cloudflare IPs). Empty = trust none.
TRUSTED_PROXIES=
SWAGGER_ENABLED=true
MIGRATE_ON_START=true

# ----------------------
# PostgreSQL (docker compose publishes it on 127.0.0.1:5433 so it won't clash with a local Postgres on 5432)
# ----------------------
POSTGRES_USER=cholo
POSTGRES_PASSWORD=
POSTGRES_DB=cholobangladesh
POSTGRES_HOST_PORT=5433
DATABASE_URL=host=localhost user=cholo password=CHANGE_ME dbname=cholobangladesh port=5433 sslmode=disable TimeZone=Asia/Dhaka
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# ----------------------
# Redis
# ----------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ----------------------
# Auth / tokens
# ----------------------
JWT_SECRET=
JWT_ISSUER=cholobangladesh
# Short-lived access token; long sessions come from the rotating refresh token.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_COST=12
# HMAC key for OTP hashing (openssl rand -hex 32)
OTP_HMAC_SECRET=
# AES-256 key for NID numbers (openssl rand -base64 32). Losing it = cannot read stored NIDs.
DATA_ENCRYPTION_KEY=

# ----------------------
# User Managments
# ----------------------
USER_BLOCK_TIME=3m
USER_MAX_FAILED_ATTEMPTS=5
USER_FAILED_ATTEMPT_WINDOW=15m
USER_PASSWORD_RESET_TOKEN_EXPIRE_IN=15m
USER_REGISTRATION_TOKEN_EXPIRE_IN=30m

# ----------------------
# OTP
# ----------------------
OTP_LENGTH=6
OTP_EXPIRES_IN=5m
OTP_RESEND_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
SMS_MAX_PER_IP_PER_DAY=10
# DEVELOPMENT ONLY (server refuses to start with these in production):
# every OTP becomes this fixed code, and it is returned as "dev_otp" in send-otp responses.
DEV_OTP_CODE=123456
DEV_EXPOSE_OTP=true

# ----------------------
# Rate limits (per IP unless noted)
# ----------------------
RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_OTP_SEND_PER_10MIN=5
RATE_LIMIT_UPLOADS_PER_HOUR=20
MAX_BODY_SIZE_KB=1024
MAX_UPLOAD_SIZE_MB=5

# ----------------------
# Bot protection (Cloudflare Turnstile) — sent by frontend in X-Captcha-Token
# ----------------------
CAPTCHA_ENABLED=false
TURNSTILE_SECRET_KEY=

# ----------------------
# Social login (comma separated client IDs: web, android, ios)
# ----------------------
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ----------------------
# Bootstrap admin (created on startup if missing)
# ----------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Platform Admin

# ----------------------
# claudinary image upload
# ----------------------
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=cholobangladesh

# ----------------------
# Phone (BulkSMSBD)
# false in development = OTP is printed in the server log instead of being sent
# ----------------------
SMS_ENABLED=false
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# ----------------------
# Email (SMTP — Gmail app password)
# ----------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=you@example.com
SMTP_FROM_NAME=CholoBangladesh

# ----------------------
# Tourist spot autofill (admin/moderator "fill from name"). Wikipedia is always used, no key needed.
# ----------------------
# YouTube Data API v3 key (Google Cloud console) -> travel videos
YOUTUBE_API_KEY=
# Google Programmable Search (Custom Search JSON API) with image search on -> more photos
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
# AI writing with Claude: subtitle, description, highlights, best time, Bangla title
AI_AUTOFILL_ENABLED=false
AI_AUTOFILL_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ----------------------
# Guide marketplace
# ----------------------
# Gigs a guide can publish for free. More require extra slots (granted by admin; paid purchase comes later).
FREE_GIG_LIMIT=5
